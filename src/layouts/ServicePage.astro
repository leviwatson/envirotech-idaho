---
/**
 * Service page shell (§9, §10, §14).
 *
 * STRUCTURE ONLY. Every word on the rendered page comes from the collection
 * entry or from src/data/service-defaults.ts. If you find yourself typing a
 * sentence into this file, it belongs in one of those instead.
 *
 * Section order is fixed here so pages cannot drift apart:
 *   hero → intro → problem → process → containment → scope → timeline →
 *   inspection vs testing → insurance → service areas → FAQ → final CTA
 *
 * Schema: Service + BreadcrumbList + FAQPage. No PostalAddress (§3 — service
 * area business), no aggregateRating (§2.2 — zero reviews today).
 */
import type { CollectionEntry } from "astro:content";
import Base from "./Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { buildGraph } from "../lib/schema";
import SeamDivider from "../components/SeamDivider.astro";
import LeadForm from "../components/LeadForm.astro";
import PhotoSlot from "../components/PhotoSlot.astro";
import DesktopCtaBar from "../components/DesktopCtaBar.astro";
import { renderProse } from "../lib/prose";
import { resolveLinks, labelFor } from "../lib/links";
import {
  TRUST_STRIP,
  CONTAINMENT,
  INSPECTION_TESTING,
  INSURANCE,
  SERVICE_AREAS,
} from "../data/service-defaults";
import { BUSINESS_NAME, PHONE_DISPLAY, PHONE_HREF, CITIES, DOMAIN } from "../data/site";

interface Props {
  entry: CollectionEntry<"services">;
}
const { entry } = Astro.props;
const d = entry.data;

// Entry overrides win; otherwise the sitewide §6 wording.
const containment = { ...CONTAINMENT, ...d.containment };
const inspection = { ...INSPECTION_TESTING, ...d.inspectionTesting };
const insurance = { ...INSURANCE, ...d.insurance };
const areas = { ...SERVICE_AREAS, ...d.serviceAreas };

const related = [...resolveLinks(d.relatedProblems), ...resolveLinks(d.relatedCities)];

/**
 * Seam divider placement (§13). Four thematic shifts, fixed here rather than
 * per entry, so every service page breaks in the same places:
 *
 *   1. before the process   — explanation gives way to procedure
 *   2. before the scope     — procedure gives way to scope and terms
 *   3. before the terms     — scope gives way to commercial terms
 *   4. before the FAQ       — terms give way to Q&A
 *
 * A divider is suppressed where a full-bleed band already marks the shift.
 * The band's own edge is the break; a rule stacked against it reads as a
 * doubled line. The containment band sits immediately before the scope, so
 * position 2 is off on every page that renders it — which is every page,
 * today. If a service ever drops the band, its divider returns on its own.
 */
// An entry may opt out; otherwise the band renders. Its presence is what
// suppresses the scope divider, so the two stay in sync automatically.
const rendersContainmentBand = d.showContainment && Boolean(containment.paragraphs?.length);
const seam = {
  beforeProcess: true,
  beforeScope: !rendersContainmentBand,
  beforeTerms: true,
  beforeFaq: true,
};

const photos = d.photos;
// Containment falls back to the sitewide slot so a service that declares no
// photos still reserves the space on the callout.
const containmentPhoto = photos?.containment ?? {
  name: CONTAINMENT.photo,
  ratio: "3/2",
  caption: CONTAINMENT.photoCaption,
  alt: undefined,
  src: undefined,
  tone: "dark" as const,
};
const cityLinks = resolveLinks(CITIES.map((c) => `/mold-remediation-${c.toLowerCase()}/`));

const origin = `https://${DOMAIN}`;
const url = `${origin}${Astro.url.pathname}`;

const graph = buildGraph({
  url,
  crumbs: [{ name: labelFor(Astro.url.pathname) ?? d.h1, href: Astro.url.pathname }],
  faqs: d.faqs,
  service: {
    name: d.h1,
    serviceType: d.serviceType,
    description: d.metaDescription,
  },
});
---

<Base title={d.title} description={d.metaDescription} graph={graph}>
  <Breadcrumbs crumbs={[{ name: labelFor(Astro.url.pathname) ?? d.h1, href: Astro.url.pathname }]} />

  {/* --- Hero ---------------------------------------------------------- */}
  <section class="container hero">
    <div class="hero__main">
    <div class="hero__copy">
      <h1>{d.h1}</h1>
      <p class="hero__subhead">{d.subhead}</p>

      <ul class="trust">
        {
          TRUST_STRIP.map((item) => (
            <li class="trust__item">
              <span class="trust__label">{item.label}</span>
              <span class="trust__detail">{item.detail}</span>
            </li>
          ))
        }
      </ul>

      <a href={PHONE_HREF} class="hero__cta">
        Call {PHONE_DISPLAY}
      </a>
      <p class="hero__cta-note">Or request a free inspection using the form.</p>

      {
        photos?.hero && (
          <PhotoSlot
            name={photos.hero.name}
            ratio={photos.hero.ratio}
            caption={photos.hero.caption}
            alt={photos.hero.alt}
            src={photos.hero.src}
            tone={photos.hero.tone}
            loading="eager"
            maxWidth="560px"
            sizes="(min-width: 900px) 560px, 100vw"
            class="hero__photo"
          />
        )
      }
    </div>

    {/* Intro lives in column one, directly under the hero copy. Both columns
        are independent block flows — nothing spans rows, so neither column's
        height can push the other's content down. */}
    <section class="band hero__intro">
      <h2>{d.intro.heading}</h2>
      {d.intro.paragraphs.map((p) => <p set:html={renderProse(p)} />)}
    </section>
    </div>

    <div class="hero__side">
      <div class="hero__form">
        <LeadForm id="inspection" heading="Get a free inspection" />
      </div>

      {
        photos?.intro && (
          <PhotoSlot
            name={photos.intro.name}
            ratio={photos.intro.ratio}
            caption={photos.intro.caption}
            alt={photos.intro.alt}
            src={photos.intro.src}
            tone={photos.intro.tone}
            ratioMobile="4/3"
            maxWidth="380px"
            sticky
            sizes="(min-width: 900px) 380px, 100vw"
            class="hero__intro-photo"
          />
        )
      }
    </div>
  </section>

  <div class="container">
    {/* --- The problem -------------------------------------------------- */}
    <section class="band">
      <h2>{d.problem.heading}</h2>
      {d.problem.paragraphs.map((p) => <p set:html={renderProse(p)} />)}
    </section>

    {seam.beforeProcess && <SeamDivider />}

    {/* --- Process. Numbered markers are used here and nowhere else (§13). */}
    <section class="band">
      <h2>{d.process.heading}</h2>
      {d.process.intro && <p class="band__intro" set:html={renderProse(d.process.intro)} />}
      <ol class="steps">
        {
          d.process.steps.map((step, i) => (
            <li class="step">
              <span class="step__marker mono" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div class="step__body">
                <h3 class="step__title">{step.title}</h3>
                <p set:html={renderProse(step.description)} />
                {photos?.process?.afterStep === i + 1 && (
                  <PhotoSlot
                    name={photos.process.name}
                    ratio={photos.process.ratio}
                    caption={photos.process.caption}
                    alt={photos.process.alt}
                    src={photos.process.src}
                    tone={photos.process.tone}
                    maxWidth="640px"
                    sizes="(min-width: 900px) 640px, 100vw"
                    class="step__photo"
                  />
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </section>
  </div>

  {/* --- Containment callout. Visually distinct: dark band, full bleed.
         Renders unless the entry opts out with showContainment: false. --- */}
  {rendersContainmentBand && (
  <section class="containment">
    <div class="container containment__inner">
      <div class="containment__copy">
        <h2>{containment.heading}</h2>
        {containment.paragraphs?.map((p) => <p set:html={renderProse(p)} />)}
      </div>
      <PhotoSlot
        name={containmentPhoto.name}
        ratio={containmentPhoto.ratio}
        caption={containmentPhoto.caption}
        alt={containmentPhoto.alt}
        src={containmentPhoto.src}
        tone="dark"
        class="containment__figure"
      />
    </div>
  </section>
  )}

  <div class="container">
    {/* --- Scope. No divider here while the containment band precedes it. */}
    {seam.beforeScope && <SeamDivider />}
    <section class="band">
      <h2>{d.scope.heading}</h2>
      {d.scope.intro && <p class="band__intro" set:html={renderProse(d.scope.intro)} />}
      <ul class="scope">
        {d.scope.items.map((item) => <li set:html={renderProse(item)} />)}
      </ul>
      {
        d.scope.excludes && (
          <>
            <h3 class="scope__excl-head">{d.scope.excludesHeading ?? "What we do not do"}</h3>
            <ul class="scope scope--excl">
              {d.scope.excludes.map((item) => <li set:html={renderProse(item)} />)}
            </ul>
          </>
        )
      }
    </section>

    {/* --- Before / after ----------------------------------------------- */}
    {
      photos?.beforeAfter && (
        <section class="band">
          <h2>{photos.beforeAfter.heading}</h2>
          <div class="ba">
            {[photos.beforeAfter.before, photos.beforeAfter.after].map((shot) => (
              <PhotoSlot
                name={shot.name}
                ratio={shot.ratio}
                caption={shot.caption}
                alt={shot.alt}
                src={shot.src}
                tone={shot.tone}
                maxWidth="480px"
                sizes="(min-width: 760px) 480px, 100vw"
              />
            ))}
          </div>
        </section>
      )
    }

    {/* --- Timeline. Figures in mono (§13). ----------------------------- */}
    <section class="band">
      <h2>{d.timeline.heading}</h2>
      <ul class="timeline">
        {
          d.timeline.stages.map((stage) => (
            <li class="timeline__row">
              <span class="timeline__figure mono">{stage.figure}</span>
              <span class="timeline__label">{stage.label}</span>
            </li>
          ))
        }
      </ul>
      {d.timeline.paragraphs.map((p) => <p set:html={renderProse(p)} />)}
    </section>

    {seam.beforeTerms && <SeamDivider />}

    {/* --- Inspection vs testing (§6) ----------------------------------- */}
    <section class="band">
      <h2>{inspection.heading}</h2>
      {inspection.paragraphs?.map((p) => <p set:html={renderProse(p)} />)}
    </section>

    {/* --- Insurance (§6, verbatim) ------------------------------------- */}
    <section class="band">
      <h2>{insurance.heading}</h2>
      {insurance.paragraphs?.map((p) => <p set:html={renderProse(p)} />)}
    </section>

    {/* --- Service areas ------------------------------------------------ */}
    <section class="band">
      <h2>{areas.heading}</h2>
      <p class="band__intro">{areas.blurb}</p>
      {
        areas.cities ? (
          /* Prose lines. City names are markdown links in the entry, so they
             become real links the moment each city page ships. */
          <ul class="areas areas--prose">
            {areas.cities.map((line) => (
              <li set:html={renderProse(line)} />
            ))}
          </ul>
        ) : (
          <ul class="areas">
            {CITIES.map((city) => {
              const link = cityLinks.find((l) => l.href.endsWith(`-${city.toLowerCase()}/`));
              return (
                <li class="areas__item">
                  {link ? <a href={link.href}>{city}</a> : <span>{city}</span>}
                </li>
              );
            })}
          </ul>
        )
      }
    </section>

    {/* --- FAQ ---------------------------------------------------------- */}
    {seam.beforeFaq && <SeamDivider />}
    <section class="band">
      <h2>Common questions</h2>
      <div class="faq">
        {
          d.faqs.map((faq) => (
            <div class="faq__item">
              <h3 class="faq__q">{faq.question}</h3>
              <p class="faq__a" set:html={renderProse(faq.answer)} />
            </div>
          ))
        }
      </div>
    </section>

    {/* --- Related reading. Unbuilt targets are already filtered out. ---- */}
    {
      related.length > 0 && (
        <section class="band">
          <h2>Related</h2>
          <ul class="related">
            {related.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {/* --- Final CTA ---------------------------------------------------- */}
    <section class="band final">
      <LeadForm
        id="request-inspection"
        heading="Request a free inspection"
      />
    </section>
  </div>

  <DesktopCtaBar watchTop="#inspection" watchBottom="#request-inspection" />
</Base>

<style>
  /* --- Hero -------------------------------------------------------------- */

  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    /* Each column sizes to its own content; they never match heights. */
    align-items: start;
    padding-block: var(--space-6) var(--space-2);
  }
  @media (min-width: 900px) {
    .hero {
      /* Roughly 55/45 in favor of the copy, so the H1 holds two lines
         instead of three. The form keeps a usable floor.
         ONE row, two columns. An earlier version had the side column span two
         rows, which made grid distribute its surplus height across both
         tracks — growing row one and opening a gap between the hero photo and
         the intro heading. align-content cannot fix that, because it is the
         tracks growing, not the container. Independent columns can. */
      grid-template-columns: minmax(0, 55fr) minmax(21rem, 45fr);
      gap: 0 var(--space-7);
    }
    /* Column one: hero copy then intro, plain block flow. */
    .hero__intro {
      padding-block-start: var(--space-4);
    }
    .hero__side {
      /* Stretches to the taller column so the photo has travel to stick. */
      align-self: stretch;
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }
  }
  .hero__subhead {
    margin-block-start: var(--space-4);
    font-size: var(--step-1);
    max-width: 46ch;
  }

  .trust {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    max-width: none;
  }
  @media (min-width: 560px) {
    .trust {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .trust__item {
    display: grid;
    gap: 2px;
    padding-inline-start: var(--space-3);
    border-inline-start: 2px solid var(--spark); /* thin accent only (§13) */
  }
  .trust__label {
    font-weight: 600;
    font-size: var(--step--1);
  }
  .trust__detail {
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--ink) 66%, var(--surface));
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    margin-block-start: var(--space-6);
    padding: var(--space-3) var(--space-6);
    background: var(--seal);
    color: var(--paper);
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: var(--track-display);
    font-size: var(--step-1);
    text-decoration: none;
  }
  .hero__cta:hover {
    background: color-mix(in srgb, var(--seal) 88%, black);
  }
  .hero__cta-note {
    margin-block-start: var(--space-3);
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--ink) 66%, var(--surface));
  }

  /* --- Bands ------------------------------------------------------------- */

  .band {
    padding-block: var(--space-6);
  }
  .band h2 {
    margin-block-end: var(--space-4);
  }
  .band p + p {
    margin-block-start: var(--space-4);
  }
  .band__intro {
    margin-block-end: var(--space-5);
  }

  /* --- Process steps ----------------------------------------------------- */

  /* Capped at the text measure so the step rules end where the copy ends
     rather than running on to the container edge (§13). */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    counter-reset: step;
    max-width: var(--measure);
  }
  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: start;
    padding-block-end: var(--space-5);
    border-block-end: 1px solid var(--rule);
  }
  .step:last-child {
    border-block-end: 0;
    padding-block-end: 0;
  }
  .step__marker {
    font-size: var(--step-1);
    color: var(--seal);
    line-height: 1.2;
  }
  .step__title {
    font-size: var(--step-1);
    margin-block-end: var(--space-2);
  }

  /* --- Containment callout ----------------------------------------------- */

  /* Dark band, deliberately unlike every other section on the page — this is
     the differentiator and it should read as a separate object. */
  .containment {
    margin-block: var(--space-8);
    padding-block: var(--space-8);
    background: var(--ink);
    color: var(--surface);
  }
  .containment__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: start;
  }
  @media (min-width: 900px) {
    .containment__inner {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .containment h2 {
    color: var(--paper);
    margin-block-end: var(--space-4);
  }
  .containment p + p {
    margin-block-start: var(--space-4);
  }
  /* Spacing only. Every slot's size and sticky behavior is set through
     PhotoSlot props, on the element itself — see the note in that component
     on why parent-authored selectors are the wrong place for it. */
  .hero__copy :global(.hero__photo) {
    margin-block-start: var(--space-3);
  }

  @media (max-width: 899px) {
    /* display:contents promotes all four blocks to grid items so they can be
       ordered independently: copy, form, intro, then the photo below the text
       it belongs to. Not sticky at this width. */
    .hero__main,
    .hero__side {
      display: contents;
    }
    .hero__copy {
      order: 1;
    }
    .hero__form {
      order: 2;
    }
    .hero__intro {
      order: 3;
    }
    .hero__side :global(.hero__intro-photo) {
      order: 4;
    }
    /* Stacked at full width, the desktop gaps read as dead space. */
    .hero__intro {
      padding-block: var(--space-3) var(--space-4);
    }
    .hero__copy :global(.hero__photo) {
      margin-block-end: 0;
    }
  }

  .step__body :global(.step__photo) {
    margin-block-start: var(--space-4);
  }

  /* Before / after pair — side by side on desktop, stacked below. */
  .ba {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }
  /* Stacked and full width on phones; two-up only when the pair can be read
     side by side without either shot going postage-stamp. */
  @media (min-width: 760px) {
    .ba {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* --- Scope -------------------------------------------------------------- */

  .scope {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .scope li {
    padding-inline-start: var(--space-5);
    position: relative;
  }
  .scope li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.62em;
    width: 8px;
    height: 1px;
    background: var(--seal);
  }
  .scope--excl li::before {
    background: var(--rule);
  }
  .scope__excl-head {
    margin-block: var(--space-6) var(--space-4);
    font-size: var(--step-1);
  }

  /* --- Timeline ----------------------------------------------------------- */

  .timeline {
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
    display: grid;
    gap: var(--space-3);
    max-width: var(--measure);
  }
  .timeline__row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-4);
    align-items: baseline;
    padding-block-end: var(--space-3);
    border-block-end: 1px solid var(--rule);
  }
  /* A rule under the last row closes a box that is not there. */
  .timeline__row:last-child {
    border-block-end: 0;
    padding-block-end: 0;
  }
  .timeline__figure {
    color: var(--seal);
    font-size: var(--step-0);
  }

  /* --- Areas / FAQ / related ---------------------------------------------- */

  /* Prose variant: one line per city, hairline-marked like the scope list. */
  .areas--prose {
    display: grid;
    gap: var(--space-4);
    font-weight: 400;
  }
  .areas--prose li {
    max-width: var(--measure);
    padding-inline-start: var(--space-5);
    position: relative;
  }
  .areas--prose li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.62em;
    width: 8px;
    height: 1px;
    background: var(--spark);
  }

  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    font-weight: 600;
    max-width: none;
  }

  .faq {
    margin: 0;
    display: grid;
    gap: var(--space-5);
  }
  .faq__q {
    font-size: var(--step-1);
    margin-block-end: var(--space-2);
  }
  .faq__a {
    margin: 0;
    max-width: var(--measure);
  }

  .related {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .final {
    padding-block-end: var(--space-8);
  }
</style>
