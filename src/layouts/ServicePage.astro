---
/**
 * Service page shell (§9, §10, §14).
 *
 * STRUCTURE ONLY. Every word on the rendered page comes from the collection
 * entry or from src/data/service-defaults.ts. If you find yourself typing a
 * sentence into this file, it belongs in one of those instead.
 *
 * Section order is fixed here so pages cannot drift apart:
 *   hero → intro → problem → process → containment → scope → timeline →
 *   inspection vs testing → insurance → service areas → FAQ → final CTA
 *
 * Schema: Service + BreadcrumbList + FAQPage. No PostalAddress (§3 — service
 * area business), no aggregateRating (§2.2 — zero reviews today).
 */
import type { CollectionEntry } from "astro:content";
import Base from "./Base.astro";
import SeamDivider from "../components/SeamDivider.astro";
import LeadForm from "../components/LeadForm.astro";
import { renderProse } from "../lib/prose";
import { resolveLinks } from "../lib/links";
import {
  TRUST_STRIP,
  CONTAINMENT,
  INSPECTION_TESTING,
  INSURANCE,
  SERVICE_AREAS,
} from "../data/service-defaults";
import { BUSINESS_NAME, PHONE_DISPLAY, PHONE_HREF, CITIES, DOMAIN } from "../data/site";

interface Props {
  entry: CollectionEntry<"services">;
}
const { entry } = Astro.props;
const d = entry.data;

// Entry overrides win; otherwise the sitewide §6 wording.
const containment = { ...CONTAINMENT, ...d.containment };
const inspection = { ...INSPECTION_TESTING, ...d.inspectionTesting };
const insurance = { ...INSURANCE, ...d.insurance };
const areas = { ...SERVICE_AREAS, ...d.serviceAreas };

const related = [...resolveLinks(d.relatedProblems), ...resolveLinks(d.relatedCities)];
const cityLinks = resolveLinks(CITIES.map((c) => `/mold-remediation-${c.toLowerCase()}/`));

const origin = `https://${DOMAIN}`;
const url = `${origin}${Astro.url.pathname}`;

const provider = {
  "@type": "HomeAndConstructionBusiness",
  name: BUSINESS_NAME,
  telephone: PHONE_DISPLAY,
  url: origin,
  areaServed: CITIES.map((city) => ({
    "@type": "City",
    name: `${city}, Idaho`,
  })),
};

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: d.h1,
    serviceType: d.serviceType,
    description: d.metaDescription,
    url,
    provider,
    areaServed: provider.areaServed,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      { "@type": "ListItem", position: 2, name: d.h1, item: url },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: d.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<Base title={d.title} description={d.metaDescription} schema={schema}>
  {/* --- Hero ---------------------------------------------------------- */}
  <section class="container hero">
    <div class="hero__copy">
      <h1>{d.h1}</h1>
      <p class="hero__subhead">{d.subhead}</p>

      <ul class="trust">
        {
          TRUST_STRIP.map((item) => (
            <li class="trust__item">
              <span class="trust__label">{item.label}</span>
              <span class="trust__detail">{item.detail}</span>
            </li>
          ))
        }
      </ul>

      <a href={PHONE_HREF} class="hero__cta">
        Call {PHONE_DISPLAY}
      </a>
      <p class="hero__cta-note">Or request a free inspection using the form.</p>
    </div>

    <div class="hero__form">
      <LeadForm id="inspection" heading="Get a free inspection" />
    </div>

    {/* Intro sits in the hero grid, under the copy and beside the form. The
        form is taller than the hero copy alone, and grid leaves that space
        empty rather than closing it — so real content fills it instead. */}
    <section class="band hero__intro">
      <h2>{d.intro.heading}</h2>
      {d.intro.paragraphs.map((p) => <p set:html={renderProse(p)} />)}
    </section>
  </section>

  <div class="container">
    {/* --- The problem -------------------------------------------------- */}
    <section class="band">
      <h2>{d.problem.heading}</h2>
      {d.problem.paragraphs.map((p) => <p set:html={renderProse(p)} />)}
    </section>

    <SeamDivider />

    {/* --- Process. Numbered markers are used here and nowhere else (§13). */}
    <section class="band">
      <h2>{d.process.heading}</h2>
      {d.process.intro && <p class="band__intro" set:html={renderProse(d.process.intro)} />}
      <ol class="steps">
        {
          d.process.steps.map((step, i) => (
            <li class="step">
              <span class="step__marker mono" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div class="step__body">
                <h3 class="step__title">{step.title}</h3>
                <p set:html={renderProse(step.description)} />
              </div>
            </li>
          ))
        }
      </ol>
    </section>
  </div>

  {/* --- Containment callout. Visually distinct: dark band, full bleed. -- */}
  <section class="containment">
    <div class="container containment__inner">
      <div class="containment__copy">
        <h2>{containment.heading}</h2>
        {containment.paragraphs?.map((p) => <p set:html={renderProse(p)} />)}
      </div>
      <figure class="containment__figure">
        {/* Real photo pending. data-photo names the PLACEHOLDERS.md token
            without emitting {{ }}, which the build guard rejects. */}
        <div class="photo-pending" data-photo={containment.photo} role="img"
          aria-label={containment.photoCaption}>
          <span class="photo-pending__tag mono">photo pending</span>
        </div>
        <figcaption>{containment.photoCaption}</figcaption>
      </figure>
    </div>
  </section>

  <div class="container">
    {/* --- Scope -------------------------------------------------------- */}
    <section class="band">
      <h2>{d.scope.heading}</h2>
      {d.scope.intro && <p class="band__intro" set:html={renderProse(d.scope.intro)} />}
      <ul class="scope">
        {d.scope.items.map((item) => <li set:html={renderProse(item)} />)}
      </ul>
      {
        d.scope.excludes && (
          <>
            <h3 class="scope__excl-head">{d.scope.excludesHeading ?? "What we do not do"}</h3>
            <ul class="scope scope--excl">
              {d.scope.excludes.map((item) => <li set:html={renderProse(item)} />)}
            </ul>
          </>
        )
      }
    </section>

    {/* --- Timeline. Figures in mono (§13). ----------------------------- */}
    <section class="band">
      <h2>{d.timeline.heading}</h2>
      <ul class="timeline">
        {
          d.timeline.stages.map((stage) => (
            <li class="timeline__row">
              <span class="timeline__figure mono">{stage.figure}</span>
              <span class="timeline__label">{stage.label}</span>
            </li>
          ))
        }
      </ul>
      {d.timeline.paragraphs.map((p) => <p set:html={renderProse(p)} />)}
    </section>

    <SeamDivider />

    {/* --- Inspection vs testing (§6) ----------------------------------- */}
    <section class="band">
      <h2>{inspection.heading}</h2>
      {inspection.paragraphs?.map((p) => <p set:html={renderProse(p)} />)}
    </section>

    {/* --- Insurance (§6, verbatim) ------------------------------------- */}
    <section class="band">
      <h2>{insurance.heading}</h2>
      {insurance.paragraphs?.map((p) => <p set:html={renderProse(p)} />)}
    </section>

    {/* --- Service areas ------------------------------------------------ */}
    <section class="band">
      <h2>{areas.heading}</h2>
      <p class="band__intro">{areas.blurb}</p>
      {
        areas.cities ? (
          /* Prose lines. City names are markdown links in the entry, so they
             become real links the moment each city page ships. */
          <ul class="areas areas--prose">
            {areas.cities.map((line) => (
              <li set:html={renderProse(line)} />
            ))}
          </ul>
        ) : (
          <ul class="areas">
            {CITIES.map((city) => {
              const link = cityLinks.find((l) => l.href.endsWith(`-${city.toLowerCase()}/`));
              return (
                <li class="areas__item">
                  {link ? <a href={link.href}>{city}</a> : <span>{city}</span>}
                </li>
              );
            })}
          </ul>
        )
      }
    </section>

    {/* --- FAQ ---------------------------------------------------------- */}
    <section class="band">
      <h2>Common questions</h2>
      <div class="faq">
        {
          d.faqs.map((faq) => (
            <div class="faq__item">
              <h3 class="faq__q">{faq.question}</h3>
              <p class="faq__a" set:html={renderProse(faq.answer)} />
            </div>
          ))
        }
      </div>
    </section>

    {/* --- Related reading. Unbuilt targets are already filtered out. ---- */}
    {
      related.length > 0 && (
        <section class="band">
          <h2>Related</h2>
          <ul class="related">
            {related.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <SeamDivider />

    {/* --- Final CTA ---------------------------------------------------- */}
    <section class="band final">
      <LeadForm
        id="request-inspection"
        heading="Request a free inspection"
        blurb="Tell us what you found. We come look at it and write you an estimate."
      />
    </section>
  </div>
</Base>

<style>
  /* --- Hero -------------------------------------------------------------- */

  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    /* Each column sizes to its own content; they never match heights. */
    align-items: start;
    padding-block: var(--space-7) var(--space-2);
  }
  @media (min-width: 900px) {
    .hero {
      /* Roughly 55/45 in favour of the copy, so the H1 holds two lines
         instead of three. The form keeps a usable floor. */
      grid-template-columns: minmax(0, 55fr) minmax(21rem, 45fr);
      gap: 0 var(--space-7);
    }
    /* Copy and intro stack in column 1; the form spans both rows in column 2.
       This is what removes the void — not an alignment property. */
    .hero__copy {
      grid-column: 1;
      grid-row: 1;
    }
    .hero__form {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    .hero__intro {
      grid-column: 1;
      grid-row: 2;
    }
  }
  .hero__subhead {
    margin-block-start: var(--space-4);
    font-size: var(--step-1);
    max-width: 46ch;
  }

  .trust {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    max-width: none;
  }
  @media (min-width: 560px) {
    .trust {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .trust__item {
    display: grid;
    gap: 2px;
    padding-inline-start: var(--space-3);
    border-inline-start: 2px solid var(--spark); /* thin accent only (§13) */
  }
  .trust__label {
    font-weight: 600;
    font-size: var(--step--1);
  }
  .trust__detail {
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--ink) 66%, var(--surface));
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    margin-block-start: var(--space-6);
    padding: var(--space-3) var(--space-6);
    background: var(--seal);
    color: var(--paper);
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: var(--track-display);
    font-size: var(--step-1);
    text-decoration: none;
  }
  .hero__cta:hover {
    background: color-mix(in srgb, var(--seal) 88%, black);
  }
  .hero__cta-note {
    margin-block-start: var(--space-3);
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--ink) 66%, var(--surface));
  }

  /* --- Bands ------------------------------------------------------------- */

  .band {
    padding-block: var(--space-6);
  }
  .band h2 {
    margin-block-end: var(--space-4);
  }
  .band p + p {
    margin-block-start: var(--space-4);
  }
  .band__intro {
    margin-block-end: var(--space-5);
  }

  /* --- Process steps ----------------------------------------------------- */

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    counter-reset: step;
    max-width: none;
  }
  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: start;
    padding-block-end: var(--space-5);
    border-block-end: 1px solid var(--rule);
  }
  .step:last-child {
    border-block-end: 0;
    padding-block-end: 0;
  }
  .step__marker {
    font-size: var(--step-1);
    color: var(--seal);
    line-height: 1.2;
  }
  .step__title {
    font-size: var(--step-1);
    margin-block-end: var(--space-2);
  }

  /* --- Containment callout ----------------------------------------------- */

  /* Dark band, deliberately unlike every other section on the page — this is
     the differentiator and it should read as a separate object. */
  .containment {
    margin-block: var(--space-8);
    padding-block: var(--space-8);
    background: var(--ink);
    color: var(--surface);
  }
  .containment__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: start;
  }
  @media (min-width: 900px) {
    .containment__inner {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .containment h2 {
    color: var(--paper);
    margin-block-end: var(--space-4);
  }
  .containment p + p {
    margin-block-start: var(--space-4);
  }
  .containment__figure {
    margin: 0;
  }
  .photo-pending {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    border: 1px dashed color-mix(in srgb, var(--rule) 40%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 4%, transparent);
  }
  .photo-pending__tag {
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--surface) 55%, transparent);
  }
  .containment__figure figcaption {
    margin-block-start: var(--space-3);
    font-size: var(--step--1);
    color: var(--rule);
  }

  /* --- Scope -------------------------------------------------------------- */

  .scope {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .scope li {
    padding-inline-start: var(--space-5);
    position: relative;
  }
  .scope li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.62em;
    width: 8px;
    height: 1px;
    background: var(--seal);
  }
  .scope--excl li::before {
    background: var(--rule);
  }
  .scope__excl-head {
    margin-block: var(--space-6) var(--space-4);
    font-size: var(--step-1);
  }

  /* --- Timeline ----------------------------------------------------------- */

  .timeline {
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
    display: grid;
    gap: var(--space-3);
    max-width: none;
  }
  .timeline__row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-4);
    align-items: baseline;
    padding-block-end: var(--space-3);
    border-block-end: 1px solid var(--rule);
  }
  .timeline__figure {
    color: var(--seal);
    font-size: var(--step-0);
  }

  /* --- Areas / FAQ / related ---------------------------------------------- */

  /* Prose variant: one line per city, hairline-marked like the scope list. */
  .areas--prose {
    display: grid;
    gap: var(--space-4);
    font-weight: 400;
  }
  .areas--prose li {
    max-width: var(--measure);
    padding-inline-start: var(--space-5);
    position: relative;
  }
  .areas--prose li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.62em;
    width: 8px;
    height: 1px;
    background: var(--spark);
  }

  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    font-weight: 600;
    max-width: none;
  }

  .faq {
    margin: 0;
    display: grid;
    gap: var(--space-5);
  }
  .faq__q {
    font-size: var(--step-1);
    margin-block-end: var(--space-2);
  }
  .faq__a {
    margin: 0;
    max-width: var(--measure);
  }

  .related {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .final {
    padding-block-end: var(--space-8);
  }
</style>
