---
/**
 * Homepage (§10).
 *
 * A routing page. Its job is to get someone to the right service page fast,
 * not to re-argue what those pages already say — so the services grid is the
 * center of gravity and every other section is deliberately brief.
 *
 * Copy lives in the collection entry; this file is structure only.
 *
 * This is the page that emits the sitewide HomeAndConstructionBusiness schema
 * §11 asks for. No PostalAddress (§3 — service-area business) and no
 * aggregateRating (§2.2 — zero reviews today).
 */
import type { CollectionEntry } from "astro:content";
import Base from "./Base.astro";
import { buildGraph } from "../lib/schema";
import SeamDivider from "../components/SeamDivider.astro";
import LeadForm from "../components/LeadForm.astro";
import TestimonialBand from "../components/TestimonialBand.astro";
import { renderProse } from "../lib/prose";
import { isBuilt, labelFor } from "../lib/links";
import { TRUST_STRIP } from "../data/service-defaults";
import { BUSINESS_NAME, PHONE_DISPLAY, PHONE_HREF, EMAIL, CITIES, DOMAIN, FOUNDED } from "../data/site";

interface Props {
  entry: CollectionEntry<"home">;
}
const { entry } = Astro.props;
const d = entry.data;

// No dead links, same rule as everywhere. The grid grows on its own.
const tiles = d.services.tiles.filter((t) => isBuilt(t.href));
// §8's three money pages lead; everything else follows at smaller weight.
const primaryTiles = tiles.filter((t) => t.primary);
const secondaryTiles = tiles.filter((t) => !t.primary);
const origin = `https://${DOMAIN}`;

// Homepage carries no breadcrumb — it is the root of the trail.
const graph = buildGraph({ url: `${origin}/`, faqs: d.faqs });

---

<Base title={d.title} description={d.metaDescription} graph={graph}>
  {/* --- Hero. Form beside the copy above the fold on desktop (§10). --- */}
  <section class="container hero">
    <div class="hero__copy">
      <h1>{d.h1}</h1>
      <p class="hero__subhead">{d.subhead}</p>

      {/* The one amber element here — emergency routing (§13). Above the call
          button, because someone with water coming in now needs the emergency
          page before they need the general number, and below the button it
          sat past the point where they would have stopped reading. */}
      <a href={d.emergency.href} class="hero__emergency">
        <span class="hero__emergency-badge mono">24/7</span>
        <span>{d.emergency.text}</span>
      </a>

      <a href={PHONE_HREF} class="hero__cta">Call {PHONE_DISPLAY}</a>
      <p class="hero__note">Free inspection. No obligation.</p>
    </div>

    <div class="hero__form">
      <LeadForm id="inspection" heading="Get a free inspection" fields="short" />
    </div>

    {/* Full-bleed across both hero columns, as its own row. It was briefly
        inside the form column, where 21rem could not hold three items and the
        third clipped mid-sentence. Spanning the grid gives all three room at
        a readable width and closes the hero, so the shorter copy column ends
        against a rule rather than trailing off into open space. */}
    <ul class="trust">
      {
        TRUST_STRIP.map((item) => (
          <li class="trust__item">
            <span class="trust__label">{item.label}</span>
            <span class="trust__detail">{item.detail}</span>
          </li>
        ))
      }
    </ul>
  </section>

  {/* --- Testimonials. Full-bleed, between the hero and the grid. Renders
         placeholder tiles on staging and nothing at all on the live domain
         until real reviews exist (§2.2). No seam divider on either side — the
         band's own edges are the break (§13). ---------------------------- */}
  <TestimonialBand />

  <div class="container">
    {/* --- Services grid: the routing core ---------------------------- */}
    <section class="band" data-services>
      <h2>{d.services.heading}</h2>
      {d.services.intro && <p class="band__intro" set:html={renderProse(d.services.intro)} />}
      <ul class="grid">
        {
          primaryTiles.map((tile) => (
            <li class="tile tile--primary">
              <a href={tile.href} class="tile__link">
                <h3 class="tile__name">{labelFor(tile.href) ?? tile.href}</h3>
                <p class="tile__line">{tile.line}</p>
              </a>
            </li>
          ))
        }
      </ul>
      {
        secondaryTiles.length > 0 && (
          <ul class="grid grid--secondary">
            {secondaryTiles.map((tile) => (
              <li class="tile tile--secondary">
                <a href={tile.href} class="tile__link">
                  <h3 class="tile__name">{labelFor(tile.href) ?? tile.href}</h3>
                  <p class="tile__line">{tile.line}</p>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    {/* --- What happens when you call. Compact, and deliberately unnumbered:
           §13 reserves numbered mono markers for the two real 7-step process
           sequences, and three reassurance beats are not one of those. ---- */}
    <section class="band steps" data-next-steps>
      <h2>{d.nextSteps.heading}</h2>
      <ol class="steps__list">
        {
          d.nextSteps.steps.map((step) => (
            <li class="steps__item">
              <h3 class="steps__title">{step.title}</h3>
              <p class="steps__line">{step.line}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <SeamDivider />

    {/* --- Containment teaser. Three sentences, then a link. ----------- */}
    <section class="band teaser">
      <h2>{d.containment.heading}</h2>
      {d.containment.paragraphs.map((p) => <p set:html={renderProse(p)} />)}
      <a href={d.containment.href} class="teaser__link">{d.containment.linkText}</a>
    </section>

    {/* --- Credentials strip ------------------------------------------ */}
    <section class="band creds" data-creds>
      <h2 class="creds__head">Licensed and certified</h2>
      <dl class="creds__list">
        <div class="cred">
          <dt>Idaho Contractor Registration</dt>
          <dd class="mono">RCE-8871958</dd>
        </div>
        <div class="cred">
          <dt>Asbestos / Mold Certification</dt>
          <dd class="mono">CMR0000023347</dd>
        </div>
        <div class="cred">
          <dt>Final clearance</dt>
          <dd>Carried out by an independent company, never by us</dd>
        </div>
      </dl>
      {/* §7 — the owner-operator wedge. A license number means more with a
          person attached to it. */}
      <div class="creds__owner">
        {d.ownerNote.map((p) => <p set:html={renderProse(p)} />)}
      </div>
    </section>

    <SeamDivider />

    {/* --- Service areas ---------------------------------------------- */}
    <section class="band">
      <h2>{d.areas.heading}</h2>
      {d.areas.intro && <p class="band__intro" set:html={renderProse(d.areas.intro)} />}
      <ul class="areas">
        {
          d.areas.cities.map((city) => (
            <li class="area">
              <h3 class="area__name">
                {isBuilt(city.href) ? <a href={city.href}>{city.name}</a> : city.name}
              </h3>
              <p class="area__line">{city.line}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {/* --- FAQ --------------------------------------------------------- */}
    <section class="band">
      <h2>Common questions</h2>
      <div class="faq">
        {
          d.faqs.map((faq) => (
            <div class="faq__item">
              <h3 class="faq__q">{faq.question}</h3>
              <p class="faq__a" set:html={renderProse(faq.answer)} />
            </div>
          ))
        }
      </div>
    </section>

    {/* Short set here too. Two forms on one page with different field counts
        reads as a bug rather than as a decision, and this is still the
        homepage — the reader who scrolled this far is more committed, not
        differently qualified. */}
    <section class="band final">
      <LeadForm
        id="request-inspection"
        heading="Request a free inspection"
        fields="short"
      />
    </section>
  </div>
</Base>

<style>
  /* --- Hero -------------------------------------------------------------- */

  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: start;
    padding-block: var(--space-7) var(--space-4);
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 55fr) minmax(21rem, 45fr);
      gap: 0 var(--space-7);
    }
    /* Row two, spanning both columns. */
    .hero .trust {
      grid-column: 1 / -1;
    }
  }
  .hero__subhead {
    margin-block-start: var(--space-4);
    font-size: var(--step-1);
    max-width: 46ch;
  }
  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    margin-block-start: var(--space-6);
    padding: var(--space-3) var(--space-6);
    background: var(--seal);
    color: var(--paper);
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: var(--track-display);
    font-size: var(--step-1);
    text-decoration: none;
  }
  .hero__cta:hover {
    background: color-mix(in srgb, var(--seal) 88%, black);
  }
  .hero__note {
    margin-block-start: var(--space-3);
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--ink) 66%, var(--surface));
  }

  /* Emergency routing — the only amber on this page (§13). */
  .hero__emergency {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-start: var(--space-5);
    padding: var(--space-3) var(--space-4);
    border-inline-start: 3px solid var(--caution);
    background: color-mix(in srgb, var(--caution) 12%, var(--surface));
    color: var(--ink);
    font-weight: 600;
    font-size: var(--step-0);
    text-decoration: none;
    border-radius: var(--radius);
  }
  .hero__emergency:hover {
    background: color-mix(in srgb, var(--caution) 22%, var(--surface));
  }
  .hero__emergency-badge {
    flex: none;
    padding: 2px 6px;
    border-radius: var(--radius);
    background: var(--caution);
    color: var(--ink);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
  }

  /* Placement only — the strip's own rules are shared, in global.css.
     Here it is a full-width row closing the hero, so it carries a rule above
     it and the copy column ends against something rather than trailing off. */
  .hero .trust {
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--rule);
  }

  /* --- Bands -------------------------------------------------------------- */

  .band {
    padding-block: var(--space-6);
  }
  .band h2 {
    margin-block-end: var(--space-4);
  }
  .band p + p {
    margin-block-start: var(--space-4);
  }
  .band__intro {
    margin-block-end: var(--space-5);
  }

  /* --- Services grid ------------------------------------------------------ */

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    max-width: none;
  }
  @media (min-width: 620px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 980px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .tile__link {
    display: block;
    height: 100%;
    padding: var(--space-5);
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink);
  }
  /* The secondary grid keeps the same tracks so both rows share a column
     edge, and separates from the primary row by weight rather than by a rule.
     Six of these under three of those was previously one flat field of nine
     in which the money pages competed with crawlspace drainage. */
  .grid--secondary {
    margin-block-start: var(--space-4);
  }
  .tile__link:hover {
    border-color: var(--seal);
  }
  .tile__name {
    font-size: var(--step-1);
    color: var(--seal);
  }
  .tile__line {
    margin-block-start: var(--space-2);
    font-size: var(--step-0);
    max-width: none;
  }

  /* Hierarchy is carried by weight and surface, not by color: --seal stays the
     one interactive green (§13) and --spark stays a thin accent, so a primary
     tile earns its emphasis with a heavier hairline and a larger heading. */
  .tile--primary .tile__link {
    border-color: color-mix(in srgb, var(--seal) 40%, var(--rule));
    border-block-start: 3px solid var(--seal);
  }
  .tile--primary .tile__name {
    font-size: var(--step-2);
  }
  .tile--secondary .tile__link {
    padding: var(--space-4);
    background: transparent;
  }
  .tile--secondary .tile__name {
    font-size: var(--step-0);
  }
  .tile--secondary .tile__line {
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--ink) 74%, var(--surface));
  }

  /* --- What happens when you call ----------------------------------------
     Compact and unnumbered. §13 gives numbered mono markers to the two real
     7-step process sequences and to nothing else, so these are separated by
     rules capped to the measure instead. */

  .steps__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
  }
  @media (min-width: 760px) {
    .steps__list {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
      max-width: none;
    }
  }
  .steps__item {
    padding-block-end: var(--space-4);
    border-block-end: 1px solid var(--rule);
  }
  /* No rule below the last item — it would close a box that is not there. */
  .steps__item:last-child {
    padding-block-end: 0;
    border-block-end: 0;
  }
  @media (min-width: 760px) {
    /* Side by side the separator becomes vertical, so the horizontal rules
       come off entirely and the first item carries no leading edge. */
    .steps__item {
      padding-block-end: 0;
      border-block-end: 0;
      padding-inline-start: var(--space-4);
      border-inline-start: 1px solid var(--rule);
    }
    .steps__item:first-child {
      padding-inline-start: 0;
      border-inline-start: 0;
    }
  }
  .steps__title {
    font-size: var(--step-0);
    font-weight: 600;
  }
  .steps__line {
    margin-block-start: var(--space-2);
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--ink) 78%, var(--surface));
    max-width: none;
  }

  /* --- Teaser ------------------------------------------------------------- */

  .teaser__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-block-start: var(--space-5);
    padding: var(--space-2) var(--space-5);
    border: 1px solid var(--seal);
    border-radius: var(--radius);
    color: var(--seal);
    font-weight: 600;
    text-decoration: none;
  }
  .teaser__link:hover {
    background: var(--seal);
    color: var(--paper);
  }

  /* --- Credentials -------------------------------------------------------- */

  .creds__head {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-0);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ink) 70%, var(--surface));
  }
  .creds__list {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 720px) {
    .creds__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .cred {
    display: grid;
    gap: var(--space-1);
    padding-inline-start: var(--space-4);
    border-inline-start: 1px solid var(--rule);
  }
  .cred dt {
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--ink) 66%, var(--surface));
  }
  .cred dd {
    margin: 0;
    font-size: var(--step-0);
    font-weight: 600;
  }
  /* Capped to the measure like any other prose in a band — the credential
     grid above it is data and runs wider, this is body copy and should not. */
  .creds__owner {
    margin-block-start: var(--space-5);
    max-width: var(--measure);
  }
  .creds__owner p + p {
    margin-block-start: var(--space-3);
  }

  /* --- Areas / FAQ -------------------------------------------------------- */

  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    max-width: none;
  }
  @media (min-width: 720px) {
    .areas {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .area__name {
    font-size: var(--step-1);
  }
  .area__line {
    margin-block-start: var(--space-2);
    font-size: var(--step-0);
  }

  .faq {
    display: grid;
    gap: var(--space-5);
  }
  .faq__q {
    font-size: var(--step-1);
    margin-block-end: var(--space-2);
  }
  .faq__a {
    margin: 0;
    max-width: var(--measure);
  }
  .final {
    padding-block-end: var(--space-8);
  }
</style>
