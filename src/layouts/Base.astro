---
/**
 * Base layout — the document shell.
 *
 * Provides <head>, global CSS, font preloads, and the header/footer/call-bar
 * chrome. Pages pass their own title + meta description (no auto-generation).
 * Content pages are NOT built yet; this is the shell they will slot into.
 */
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileCallBar from "../components/MobileCallBar.astro";
import { existsSync } from "node:fs";
import { STAGING_NOINDEX, BUSINESS_NAME } from "../data/site";

interface Props {
  title: string;
  description?: string;
  /** Keeps a page out of the index. Conversion confirmations only. */
  noindex?: boolean;
  /**
   * One JSON-LD @graph for the page, from buildGraph(). Single block rather
   * than several: the business entity is defined once and referenced by @id.
   */
  graph?: Record<string, unknown>;
}
const { title, description, noindex = false, graph } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

/**
 * Social card image. Referenced only if the asset actually exists — a broken
 * og:image is worse than none, because a scraper caches the failure. Tracked
 * in PLACEHOLDERS.md until the real file lands; the moment it does, every page
 * picks it up with no code change.
 */
const OG_IMAGE = "/og-default.jpg";
const ogImage = existsSync(`public${OG_IMAGE}`)
  ? new URL(OG_IMAGE, Astro.site ?? Astro.url).href
  : null;

/**
 * Article for content pages, website for the homepage. Derived rather than
 * passed, so a new page cannot forget to set it.
 */
const ogType = Astro.url.pathname === "/" ? "website" : "article";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {/* Open Graph and Twitter, from the same title and description that feed
        the <title> and meta description above — there is no second list to
        keep in sync (§11). */}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={BUSINESS_NAME} />
    <meta property="og:locale" content="en_US" />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {
      /* Staging blanket wins over the per-page flag; both end in noindex. */
      STAGING_NOINDEX ? (
        <meta name="robots" content="noindex" />
      ) : (
        noindex && <meta name="robots" content="noindex, follow" />
      )
    }

    {/* Preload the fonts used above the fold — self-hosted, no CDN.
        Montserrat 700 (headings) + Inter 400 (body). */}
    <link
      rel="preload"
      href="/fonts/montserrat-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {graph && <script type="application/ld+json" set:html={JSON.stringify(graph)} />}

    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileCallBar />
  </body>
</html>
