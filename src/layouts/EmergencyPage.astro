---
/**
 * Emergency page shell (§9, §10).
 *
 * Written for someone standing in water at 2am holding a phone. The order is
 * not negotiable and it is not the service-page order: phone number, then what
 * to do right now, then what happens when we arrive. Nothing that sells comes
 * before something that helps.
 *
 * Deliberately absent: trust strip, numbered process table, timeline grid,
 * service-area list, before/after photos, containment band, hero photo. Each
 * of those is useful on a service page and noise here, and a hero image would
 * cost LCP on a mobile connection to help nobody.
 *
 * This is the one page where --caution carries a full band rather than an
 * accent (§13). The persistent bottom bar stays --ink on purpose: two amber
 * bands would spend the one colour the palette reserves for exactly this.
 */
import type { CollectionEntry } from "astro:content";
import Base from "./Base.astro";
import LeadForm from "../components/LeadForm.astro";
import DesktopCtaBar from "../components/DesktopCtaBar.astro";
import SeamDivider from "../components/SeamDivider.astro";
import { renderProse } from "../lib/prose";
import { resolveLinks, labelFor } from "../lib/links";
import { BUSINESS_NAME, PHONE_DISPLAY, PHONE_HREF, CITIES, DOMAIN } from "../data/site";

interface Props {
  entry: CollectionEntry<"emergency">;
}
const { entry } = Astro.props;
const d = entry.data;

const related = [...resolveLinks(d.relatedServices), ...resolveLinks(d.relatedCities)];
const origin = `https://${DOMAIN}`;
const url = `${origin}${Astro.url.pathname}`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: d.h1,
    serviceType: "Emergency Water Damage Restoration",
    description: d.metaDescription,
    url,
    provider: {
      "@type": "HomeAndConstructionBusiness",
      name: BUSINESS_NAME,
      telephone: PHONE_DISPLAY,
      url: origin,
      // The whole premise of the page.
      openingHoursSpecification: {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
        opens: "00:00",
        closes: "23:59",
      },
      areaServed: CITIES.map((city) => ({ "@type": "City", name: `${city}, Idaho` })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      { "@type": "ListItem", position: 2, name: labelFor(Astro.url.pathname) ?? d.h1, item: url },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: d.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<Base title={d.title} description={d.metaDescription} schema={schema}>
  {/* --- The phone number, before anything else ------------------------- */}
  <a href={PHONE_HREF} class="callband" data-callband>
    <span class="callband__label">{d.callBand.label}</span>
    <span class="callband__number mono">{PHONE_DISPLAY}</span>
    <span class="callband__note">{d.callBand.note}</span>
  </a>

  <div class="container">
    <h1 class="e-h1">{d.h1}</h1>
    <p class="e-subhead">{d.subhead}</p>

    {/* --- What to do right now ----------------------------------------- */}
    <section class="actions" data-actions>
      <h2 class="actions__heading">{d.actions.heading}</h2>
      {d.actions.intro && <p class="actions__intro">{d.actions.intro}</p>}

      <ol class="actions__list">
        {
          d.actions.items.map((item, i) => (
            <li class="action">
              <span class="action__num mono" aria-hidden="true">{i + 1}</span>
              <div class="action__body">
                <h3 class="action__title">{item.title}</h3>
                <p class="action__detail">{item.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <p class="actions__caution">{d.actions.caution}</p>
    </section>

    <SeamDivider />

    {/* --- What happens when we arrive ---------------------------------- */}
    <section class="band">
      <h2>{d.arrival.heading}</h2>
      {d.arrival.intro && <p class="band__intro" set:html={renderProse(d.arrival.intro)} />}
      <ol class="arrival">
        {
          d.arrival.steps.map((step) => (
            <li class="arrival__step">
              <h3 class="arrival__title">{step.title}</h3>
              <p set:html={renderProse(step.description)} />
            </li>
          ))
        }
      </ol>
    </section>

    {/* --- Everything below the fold ------------------------------------ */}
    {
      d.sections.map((section) => (
        <section class="band">
          <h2>{section.heading}</h2>
          {section.paragraphs.map((p) => <p set:html={renderProse(p)} />)}
        </section>
      ))
    }

    <SeamDivider />

    <section class="band">
      <h2>Common questions</h2>
      <div class="faq">
        {
          d.faqs.map((faq) => (
            <div class="faq__item">
              <h3 class="faq__q">{faq.question}</h3>
              <p class="faq__a" set:html={renderProse(faq.answer)} />
            </div>
          ))
        }
      </div>
    </section>

    {
      related.length > 0 && (
        <section class="band">
          <h2>Related</h2>
          <ul class="related">
            {related.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </section>
      )
    }

    {/* Form is the secondary path here. Calling is the primary one. */}
    <section class="band final">
      <LeadForm
        id="request-inspection"
        heading="Not urgent? Send it instead."
        blurb="If the water is already stopped and you want someone to look at the damage, this reaches us too."
      />
    </section>
  </div>

  {/* No watchTop: there is no hero form to scroll past, so the bar is
      present from the top and only the closing form hides it. */}
  <DesktopCtaBar watchBottom="#request-inspection" />
</Base>

<style>
  /* --- The call band ---------------------------------------------------- */

  /* The one full band of --caution on the site. §13 reserves amber for
     emergency and 24/7 elements; this is that element. */
  .callband {
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    padding: var(--space-5) var(--gutter);
    background: var(--caution);
    color: var(--ink);
    text-align: center;
    text-decoration: none;
  }
  .callband__label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: var(--track-display);
  }
  .callband__number {
    font-size: clamp(2rem, 1.4rem + 3vw, 3.2rem);
    line-height: 1.05;
    font-weight: 400;
  }
  .callband__note {
    font-size: var(--step-0);
    font-weight: 600;
  }
  .callband:active {
    background: color-mix(in srgb, var(--caution) 88%, black);
  }

  .e-h1 {
    margin-block-start: var(--space-7);
    font-size: var(--step-3);
  }
  .e-subhead {
    margin-block-start: var(--space-4);
    font-size: var(--step-1);
  }

  /* --- Right now -------------------------------------------------------- */

  /* Legibility over elegance, deliberately. This is read with wet hands, on a
     cracked screen, in the dark, by someone who is not calm. Type is a step
     larger than the rest of the site, contrast is full --ink on --paper, and
     the rows are spaced far enough apart that a shaking thumb cannot lose its
     place between them. */
  .actions {
    margin-block-start: var(--space-7);
    padding: var(--space-6);
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
  }
  .actions__heading {
    font-size: var(--step-2);
  }
  .actions__intro {
    margin-block-start: var(--space-3);
    font-size: var(--step-1);
  }

  .actions__list {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-6); /* generous — one item per glance */
    max-width: none;
  }
  .action {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: start;
  }
  .action__num {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-size: var(--step-1);
    line-height: 1;
  }
  .action__title {
    font-size: var(--step-2);
    line-height: var(--leading-snug);
    color: var(--ink);
  }
  .action__detail {
    margin-block-start: var(--space-2);
    font-size: var(--step-1);
    line-height: var(--leading-normal);
    color: var(--ink); /* full contrast, not the muted body colour */
    max-width: none;
  }

  .actions__caution {
    margin-block-start: var(--space-6);
    padding: var(--space-4);
    border-inline-start: 4px solid var(--caution);
    background: color-mix(in srgb, var(--caution) 10%, var(--paper));
    font-size: var(--step-1);
    font-weight: 600;
    max-width: none;
  }

  /* --- Arrival and the rest -------------------------------------------- */

  .band {
    padding-block: var(--space-6);
  }
  .band h2 {
    margin-block-end: var(--space-4);
  }
  .band p + p {
    margin-block-start: var(--space-4);
  }
  .band__intro {
    margin-block-end: var(--space-5);
  }

  .arrival {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    max-width: var(--measure);
  }
  .arrival__step {
    padding-block-end: var(--space-5);
    border-block-end: 1px solid var(--rule);
  }
  .arrival__step:last-child {
    border-block-end: 0;
    padding-block-end: 0;
  }
  .arrival__title {
    font-size: var(--step-1);
    margin-block-end: var(--space-2);
  }

  .faq {
    display: grid;
    gap: var(--space-5);
  }
  .faq__q {
    font-size: var(--step-1);
    margin-block-end: var(--space-2);
  }
  .faq__a {
    margin: 0;
    max-width: var(--measure);
  }
  .related {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .final {
    padding-block-end: var(--space-8);
  }

  @media (max-width: 560px) {
    .actions {
      padding: var(--space-5) var(--space-4);
    }
  }
</style>
