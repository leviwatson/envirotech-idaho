---
/**
 * Guide / visual walkthrough shell — the signature page (§10).
 *
 * Photo-led: each element of the build is an image with copy beside it, and
 * the copy is deliberately short because the photograph is the argument. The
 * layout alternates sides on desktop for rhythm and stacks photo-first on
 * mobile, so a phone reader sees the thing before reading about it.
 *
 * No numbered markers. §13 reserves those for the two 7-step process
 * sequences; order here is carried by sequence and by the copy.
 *
 * This page holds the site's ONE scroll-triggered reveal (§13). It is opt-in
 * per element, cheap, and fully disabled under prefers-reduced-motion — the
 * elements are visible from the start and the script only adds the transition.
 */
import type { CollectionEntry } from "astro:content";
import Base from "./Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { buildGraph } from "../lib/schema";
import SeamDivider from "../components/SeamDivider.astro";
import LeadForm from "../components/LeadForm.astro";
import PhotoSlot from "../components/PhotoSlot.astro";
import DesktopCtaBar from "../components/DesktopCtaBar.astro";
import { renderProse } from "../lib/prose";
import { resolveLinks, labelFor } from "../lib/links";
import { BUSINESS_NAME, PHONE_DISPLAY, PHONE_HREF, DOMAIN } from "../data/site";

interface Props {
  entry: CollectionEntry<"guides">;
}
const { entry } = Astro.props;
const d = entry.data;

const related = resolveLinks(d.relatedServices);
const origin = `https://${DOMAIN}`;
const url = `${origin}${Astro.url.pathname}`;

const crumbs = [{ name: labelFor(Astro.url.pathname) ?? d.h1, href: Astro.url.pathname }];

const graph = buildGraph({
  url,
  crumbs,
  faqs: d.faqs,
});

---

<Base title={d.title} description={d.metaDescription} graph={graph}>
  <Breadcrumbs crumbs={crumbs} />

  {/* --- Hero. No form above it: this page earns trust before it asks. --- */}
  <section class="container g-hero">
    <h1>{d.h1}</h1>
    <p class="g-hero__subhead">{d.subhead}</p>
    <a href={PHONE_HREF} class="g-hero__call">Call {PHONE_DISPLAY}</a>
  </section>

  {
    d.hero?.src && (
      <div class="container g-hero__figure">
        <PhotoSlot
          name={d.hero.name}
          ratio={d.hero.ratio}
          ratioMobile="4/3"
          caption={d.hero.caption}
          alt={d.hero.alt}
          src={d.hero.src}
          loading="eager"
          sizes="(min-width: 1200px) 1100px, 100vw"
        />
      </div>
    )
  }

  <div class="container">
    {/* --- The one idea ------------------------------------------------- */}
    <section class="band premise">
      <h2>{d.premise.heading}</h2>
      {d.premise.paragraphs.map((p) => <p set:html={renderProse(p)} />)}
    </section>

    <SeamDivider />

    {/* --- The build ---------------------------------------------------- */}
    <section class="band">
      <h2>{d.build.heading}</h2>
      {d.build.intro && <p class="band__intro" set:html={renderProse(d.build.intro)} />}
    </section>
  </div>

  <div class="elements">
    {
      d.build.elements.map((el, i) => (
        <section
          class:list={["container element", !el.photo.src && "element--text"]}
          data-reveal
          data-flip={i % 2 === 1 ? "" : undefined}
        >
          {el.photo.src && (
          <div class="element__figure">
            <PhotoSlot
              name={el.photo.name}
              ratio={el.photo.ratio}
              ratioMobile="4/3"
              caption={el.photo.caption}
              alt={el.photo.alt}
              src={el.photo.src}
              sizes="(min-width: 900px) 46vw, 100vw"
            />
          </div>
          )}
          <div class="element__copy">
            <h3 class="element__name">{el.name}</h3>
            <p class="element__what" set:html={renderProse(el.what)} />
            <p set:html={renderProse(el.why)} />
            <p class="element__without">
              <span class="element__without-label">Without it</span>
              <span set:html={renderProse(el.without)} />
            </p>
          </div>
        </section>
      ))
    }
  </div>

  <div class="container">
    <SeamDivider />

    {/* --- The checklist. The reason anyone links to this page. --------- */}
    <section class="band">
      <h2>{d.checklist.heading}</h2>
      {d.checklist.intro && <p class="band__intro" set:html={renderProse(d.checklist.intro)} />}
      <ul class="checks">
        {
          d.checklist.items.map((item) => (
            <li class="check">
              <h3 class="check__ask">{item.ask}</h3>
              <p class="check__detail" set:html={renderProse(item.detail)} />
            </li>
          ))
        }
      </ul>
      {d.checklist.outro?.map((p) => <p class="checks__outro" set:html={renderProse(p)} />)}
    </section>

    <SeamDivider />

    {d.sections.map((section) => (
      <section class="band">
        <h2>{section.heading}</h2>
        {section.paragraphs.map((p) => <p set:html={renderProse(p)} />)}
      </section>
    ))}

    <SeamDivider />

    <section class="band">
      <h2>Common questions</h2>
      <div class="faq">
        {
          d.faqs.map((faq) => (
            <div class="faq__item">
              <h3 class="faq__q">{faq.question}</h3>
              <p class="faq__a" set:html={renderProse(faq.answer)} />
            </div>
          ))
        }
      </div>
    </section>

    {
      related.length > 0 && (
        <section class="band">
          <h2>Where this applies</h2>
          <ul class="related">
            {related.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="band final">
      <LeadForm
        id="request-inspection"
        heading="Ask us to show you"
      />
    </section>
  </div>

  <DesktopCtaBar watchBottom="#request-inspection" />
</Base>

<style>
  /* --- Hero ------------------------------------------------------------- */

  .g-hero {
    padding-block: var(--space-8) var(--space-6);
    max-width: min(var(--container), 62rem);
  }
  .g-hero__subhead {
    margin-block-start: var(--space-4);
    font-size: var(--step-1);
  }
  .g-hero__call {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    margin-block-start: var(--space-6);
    padding: var(--space-3) var(--space-6);
    background: var(--seal);
    color: var(--paper);
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: var(--track-display);
    font-size: var(--step-1);
    text-decoration: none;
  }
  .g-hero__call:hover {
    background: color-mix(in srgb, var(--seal) 88%, black);
  }
  .g-hero__figure {
    margin-block-end: var(--space-7);
  }

  /* --- Bands ------------------------------------------------------------ */

  .band {
    padding-block: var(--space-6);
  }
  .band h2 {
    margin-block-end: var(--space-4);
  }
  .band p + p {
    margin-block-start: var(--space-4);
  }
  .band__intro {
    margin-block-end: var(--space-5);
  }
  .premise p {
    font-size: var(--step-1);
  }

  /* --- The build -------------------------------------------------------- */

  .elements {
    display: grid;
    gap: var(--space-8);
    padding-block-end: var(--space-7);
  }

  /* Photo first on mobile: see the thing, then read about it. */
  .element {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    align-items: center;
  }
  @media (min-width: 900px) {
    .element {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-7);
    }
    /* Alternating sides. Rhythm, not decoration — the seam stays the site's
       only motif (§13). */
    .element[data-flip] .element__figure {
      order: 2;
    }
    /* No photo yet: the copy takes one readable column rather than sitting
       beside an empty half. */
    .element--text {
      grid-template-columns: minmax(0, 46rem);
    }
  }

  .element__name {
    font-size: var(--step-2);
    margin-block-end: var(--space-3);
  }
  .element__what {
    font-size: var(--step-1);
    font-weight: 600;
  }
  .element__copy p + p {
    margin-block-start: var(--space-4);
  }

  .element__without {
    display: grid;
    gap: var(--space-2);
    padding-inline-start: var(--space-4);
    border-inline-start: 2px solid var(--spark);
  }
  .element__without-label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--seal);
  }

  /* The site's one scroll reveal (§13). Elements start visible; the script
     opts them into the transition, so no-JS and reduced-motion both get the
     page with nothing hidden. */
  @media (prefers-reduced-motion: no-preference) {
    .element[data-reveal-armed] {
      opacity: 0;
      transform: translateY(12px);
      transition:
        opacity 0.5s ease,
        transform 0.5s ease;
    }
    .element[data-reveal-armed][data-revealed] {
      opacity: 1;
      transform: none;
    }
  }

  /* --- Checklist -------------------------------------------------------- */

  .checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    max-width: var(--measure);
  }
  .check {
    padding-block-end: var(--space-5);
    border-block-end: 1px solid var(--rule);
  }
  .check:last-child {
    border-block-end: 0;
    padding-block-end: 0;
  }
  .check__ask {
    font-size: var(--step-1);
    margin-block-end: var(--space-2);
  }
  .check__detail {
    margin: 0;
  }
  .checks__outro {
    margin-block-start: var(--space-5);
    max-width: var(--measure);
  }

  /* --- FAQ / related ---------------------------------------------------- */

  .faq {
    display: grid;
    gap: var(--space-5);
  }
  .faq__q {
    font-size: var(--step-1);
    margin-block-end: var(--space-2);
  }
  .faq__a {
    margin: 0;
    max-width: var(--measure);
  }
  .related {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .final {
    padding-block-end: var(--space-8);
  }
</style>

<script>
  /**
   * The single scroll-triggered reveal on the site (§13).
   *
   * Elements render visible. This arms the transition only when motion is
   * welcome, so a reduced-motion or no-JS reader never gets a page with
   * content hidden behind a script that might not run.
   */
  if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    const elements = document.querySelectorAll<HTMLElement>("[data-reveal]");
    for (const el of elements) el.dataset.revealArmed = "";

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          (entry.target as HTMLElement).dataset.revealed = "";
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -10% 0px" },
    );

    for (const el of elements) observer.observe(el);
  }
</script>
