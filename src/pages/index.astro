---
/**
 * Placeholder home page — NOT the real homepage content.
 *
 * This exists only to exercise the design system (layout, header, footer,
 * seam divider, mobile call bar) so the build pipeline can be verified
 * end-to-end before any content pages are written (build order step 1).
 * Replace entirely when /  is built for real.
 */
import Base from "../layouts/Base.astro";
import SeamDivider from "../components/SeamDivider.astro";
import LeadForm from "../components/LeadForm.astro";
---

<Base
  title="Enviro-Tech Idaho — Design System Preview"
  description="Internal design system preview. Not a content page."
>
  <section class="container" style="padding-block: var(--space-8);">
    <p class="mono" style="color: var(--seal);">Design system preview</p>
    <h1>Containment-first restoration.</h1>
    <p style="margin-block-start: var(--space-4);">
      This placeholder confirms the tokens, self-hosted fonts, base layout,
      header, footer, and mobile call bar are wired correctly. No content
      pages have been built yet.
    </p>

    <SeamDivider />

    <p class="mono">RCE-8871958</p>

    <SeamDivider />

    {/* Lead form preview — full width here, compact variant below, so both
        layouts get exercised before any real page consumes them. */}
    <div class="form-preview">
      <LeadForm id="lead-form" />
      <LeadForm
        id="lead-form-compact"
        compact
        heading="Free inspection"
        blurb="Tell us what you are seeing and we will come look at it."
      />
    </div>
  </section>
</Base>

<style>
  .form-preview {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }
  @media (min-width: 900px) {
    .form-preview {
      grid-template-columns: 1.6fr 1fr;
    }
  }
</style>
