---
/**
 * Homepage (§10). Thin consumer — copy lives in the `home` collection entry
 * and the structure lives in HomePage.astro.
 */
import { getEntry } from "astro:content";
import HomePage from "../layouts/HomePage.astro";

const entry = await getEntry("home", "index");
if (!entry) throw new Error("src/content/home/index.md is missing");
---

<HomePage entry={entry} />
