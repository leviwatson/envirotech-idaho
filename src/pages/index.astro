---
/**
 * Placeholder home page — NOT the real homepage content (build order step 4+).
 *
 * The hero layout here is real though: §10 puts the lead form above the fold
 * on desktop, so it sits beside the intro rather than below the page. Replace
 * the copy when / is built for real; keep the form where it is.
 */
import Base from "../layouts/Base.astro";
import SeamDivider from "../components/SeamDivider.astro";
import LeadForm from "../components/LeadForm.astro";
---

<Base
  title="Enviro-Tech Idaho — Design System Preview"
  description="Internal design system preview. Not a content page."
>
  {/* Above the fold: intro left, lead form right (§10). */}
  <section class="container hero">
    <div class="hero__intro">
      <p class="mono hero__eyebrow">Design system preview</p>
      <h1>Containment-first restoration.</h1>
      <p class="hero__lead">
        This placeholder confirms the tokens, self-hosted fonts, base layout,
        header, nav, footer, and mobile call bar are wired correctly. No
        content pages have been built yet.
      </p>
      <p class="mono hero__cred">RCE-8871958</p>
    </div>

    <div class="hero__form">
      <LeadForm id="lead-form" />
    </div>
  </section>

  <SeamDivider class="container" />
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: start;
    padding-block: var(--space-7);
  }
  /* Two-up from 900px so the form clears the fold on desktop. */
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1fr minmax(24rem, 30rem);
      gap: var(--space-8);
    }
  }

  .hero__eyebrow {
    color: var(--seal);
  }
  .hero__intro h1 {
    margin-block-start: var(--space-3);
  }
  .hero__lead {
    margin-block-start: var(--space-4);
    font-size: var(--step-1);
  }
  .hero__cred {
    margin-block-start: var(--space-5);
  }
</style>
