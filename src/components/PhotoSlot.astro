---
/**
 * PhotoSlot — a photo position that exists before the photo does.
 *
 * Empty, it renders a skeleton at the exact aspect ratio the real image will
 * occupy, so nothing on the page moves when photography lands. It reads as a
 * loading state rather than a build artifact: no text, no border, no dashed
 * box. Filled, it renders an optimized <Image> with explicit dimensions.
 *
 * The slot name rides on data-photo. It is deliberately NOT a {{TOKEN}} — the
 * build guard fails on {{ anywhere in dist/, and these slots have to be able
 * to ship to a live page while the photography is still outstanding.
 *
 * tone="dark" is for slots sitting on the --ink containment band, where a
 * light skeleton would read as a bright hole rather than a pending image.
 */
import { Picture } from "astro:assets";

interface Props {
  /** Slot name, e.g. PHOTO_HERO. Tracked in PLACEHOLDERS.md. */
  name: string;
  /** CSS aspect ratio, e.g. "4/3". Reserved whether or not an image exists. */
  ratio?: string;
  /**
   * Ratio below 900px. A portrait slot that works beside a column of text on
   * desktop becomes a very tall block at full width on a phone, so a slot can
   * change shape rather than change size. Defaults to `ratio`.
   */
  ratioMobile?: string;
  caption?: string;
  /** Imported image. Absent until real photography is supplied. */
  src?: ImageMetadata;
  alt?: string;
  tone?: "light" | "dark";
  /**
   * Rendered cap, e.g. "560px". Applied to the figure itself rather than by a
   * rule in the consuming layout — a class passed into this component lands
   * on an element carrying THIS component's style scope, so parent-authored
   * selectors need :global() and silently do nothing without it. Sizing that
   * matters belongs on the element.
   */
  maxWidth?: string;
  align?: "start" | "center";
  /** Holds position while adjacent copy scrolls. Static below 900px. */
  sticky?: boolean;
  /** Only the hero slot is eager. Everything below the fold lazy-loads. */
  loading?: "lazy" | "eager";
  /**
   * How wide this slot actually renders, so the browser picks the smallest
   * adequate candidate. Getting this wrong is how a phone ends up pulling the
   * 1600px file, which is the whole thing we are avoiding.
   */
  sizes?: string;
  class?: string;
}

const {
  name,
  ratio = "4/3",
  ratioMobile,
  caption,
  src,
  alt,
  tone = "light",
  maxWidth,
  align = "start",
  sticky = false,
  loading = "lazy",
  sizes = "(min-width: 900px) 40vw, 100vw",
  class: className,
} = Astro.props;
---

<figure
  class:list={[
    "photo",
    `photo--${tone}`,
    `photo--${align}`,
    sticky && "photo--sticky",
    className,
  ]}
  data-photo={name}
  style={`--photo-ratio: ${ratio}; --photo-ratio-mobile: ${ratioMobile ?? ratio}; --photo-max: ${maxWidth ?? "100%"};`}
>
  {
    src ? (
      <Picture
        src={src}
        alt={alt ?? ""}
        formats={["avif", "webp"]}
        fallbackFormat="jpeg"
        widths={[400, 800, 1200, 1600]}
        sizes={sizes}
        loading={loading}
        decoding={loading === "eager" ? "auto" : "async"}
        fetchpriority={loading === "eager" ? "high" : "auto"}
        class="photo__img"
      />
    ) : (
      /* Decorative while empty — there is nothing here to describe yet. */
      <div class="photo__skeleton" aria-hidden="true" />
    )
  }
  {caption && <figcaption class="photo__caption">{caption}</figcaption>}
</figure>

<style>
  .photo {
    margin: 0;
    width: 100%;
    /* The cap lives here, on the element, driven by an inline custom property.
       Nothing about a slot's size depends on the layout that placed it. */
    max-width: var(--photo-max, 100%);
  }
  .photo--center {
    margin-inline: auto;
  }
  .photo--start {
    margin-inline-end: auto;
  }
  .photo--sticky {
    position: sticky;
    top: calc(var(--header-h, 65px) + var(--space-5));
  }
  @media (max-width: 899px) {
    .photo--sticky {
      position: static;
    }
  }

  .photo__img,
  .photo__skeleton {
    width: 100%;
    aspect-ratio: var(--photo-ratio);
    border-radius: var(--radius);
    display: block;
  }
  .photo__img {
    object-fit: cover;
    height: auto;
  }

  /* Skeleton: a slow pass of slightly warmer --rule across --surface. Soft
     enough to read as "loading", never as a placeholder graphic. */
  .photo__skeleton {
    background-image: linear-gradient(
      100deg,
      var(--surface) 28%,
      color-mix(in srgb, var(--rule) 62%, var(--surface)) 48%,
      var(--surface) 68%
    );
    background-size: 300% 100%;
    background-repeat: no-repeat;
    animation: photo-shimmer 2.6s ease-in-out infinite;
  }

  /* On the dark containment band the same idea, inverted. */
  .photo--dark .photo__skeleton {
    background-image: linear-gradient(
      100deg,
      color-mix(in srgb, var(--surface) 5%, transparent) 28%,
      color-mix(in srgb, var(--surface) 14%, transparent) 48%,
      color-mix(in srgb, var(--surface) 5%, transparent) 68%
    );
  }

  @keyframes photo-shimmer {
    from {
      background-position: 160% 0;
    }
    to {
      background-position: -60% 0;
    }
  }

  /* Reduced motion: hold a flat tone. Setting animation-name to none matters
     here — the global reduced-motion rule only clamps duration, which would
     otherwise freeze the shimmer mid-sweep at an arbitrary position. */
  @media (prefers-reduced-motion: reduce) {
    .photo__skeleton {
      animation: none;
      background-image: none;
      background-color: color-mix(in srgb, var(--rule) 40%, var(--surface));
    }
    .photo--dark .photo__skeleton {
      background-color: color-mix(in srgb, var(--surface) 9%, transparent);
    }
  }

  /* Phones get the mobile ratio, and a tighter caption — at full width the
     desktop gap reads as the caption drifting away from its image. */
  @media (max-width: 899px) {
    .photo__img,
    .photo__skeleton {
      aspect-ratio: var(--photo-ratio-mobile, var(--photo-ratio));
    }
    .photo__caption {
      margin-block-start: var(--space-2);
    }
  }

  .photo__caption {
    /* Wraps inside the slot. Without this a long caption sets the figure's
       width and drags the image out with it. */
    max-width: 100%;
    overflow-wrap: break-word;
    margin-block-start: var(--space-3);
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--ink) 66%, var(--surface));
  }
  .photo--dark .photo__caption {
    color: var(--rule);
  }
</style>
