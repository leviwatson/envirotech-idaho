---
/**
 * PhotoSlot — a named photo position, filled from content data.
 *
 * Without `src` it renders nothing: no skeleton, no caption, no figure. An
 * empty grey box on a live page reads as broken, so a slot only appears once
 * real photography exists. Layouts that place a slot inside a grid column
 * should check `src` themselves and drop the column, or the page keeps a hole
 * where the photo would have been.
 *
 * The slot name rides on data-photo. It is deliberately NOT a {{TOKEN}} — the
 * build guard fails on {{ anywhere in dist/, and an unfilled slot has to be
 * able to sit in content while the photography is still outstanding.
 *
 * tone="dark" is for slots sitting on the --ink containment band.
 */
import { Picture } from "astro:assets";

interface Props {
  /** Slot name, e.g. PHOTO_HERO. Tracked in PLACEHOLDERS.md. */
  name: string;
  /** CSS aspect ratio, e.g. "4/3". Reserved whether or not an image exists. */
  ratio?: string;
  /**
   * Ratio below 900px. A portrait slot that works beside a column of text on
   * desktop becomes a very tall block at full width on a phone, so a slot can
   * change shape rather than change size. Defaults to `ratio`.
   */
  ratioMobile?: string;
  caption?: string;
  /** Imported image. Absent until real photography is supplied. */
  src?: ImageMetadata;
  alt?: string;
  tone?: "light" | "dark";
  /**
   * Rendered cap, e.g. "560px". Applied to the figure itself rather than by a
   * rule in the consuming layout — a class passed into this component lands
   * on an element carrying THIS component's style scope, so parent-authored
   * selectors need :global() and silently do nothing without it. Sizing that
   * matters belongs on the element.
   */
  maxWidth?: string;
  align?: "start" | "center";
  /** Holds position while adjacent copy scrolls. Static below 900px. */
  sticky?: boolean;
  /** Only the hero slot is eager. Everything below the fold lazy-loads. */
  loading?: "lazy" | "eager";
  /**
   * How wide this slot actually renders, so the browser picks the smallest
   * adequate candidate. Getting this wrong is how a phone ends up pulling the
   * 1600px file, which is the whole thing we are avoiding.
   */
  sizes?: string;
  class?: string;
}

const {
  name,
  ratio = "4/3",
  ratioMobile,
  caption,
  src,
  alt,
  tone = "light",
  maxWidth,
  align = "start",
  sticky = false,
  loading = "lazy",
  sizes = "(min-width: 900px) 40vw, 100vw",
  class: className,
} = Astro.props;
---

{src && (
<figure
  class:list={[
    "photo",
    `photo--${tone}`,
    `photo--${align}`,
    sticky && "photo--sticky",
    className,
  ]}
  data-photo={name}
  style={`--photo-ratio: ${ratio}; --photo-ratio-mobile: ${ratioMobile ?? ratio}; --photo-max: ${maxWidth ?? "100%"};`}
>
    <Picture
      src={src}
      alt={alt ?? ""}
      formats={["avif", "webp"]}
      fallbackFormat="jpeg"
      widths={[400, 800, 1200, 1600]}
      sizes={sizes}
      loading={loading}
      decoding={loading === "eager" ? "auto" : "async"}
      fetchpriority={loading === "eager" ? "high" : "auto"}
      class="photo__img"
    />
    {caption && <figcaption class="photo__caption">{caption}</figcaption>}
</figure>
)}

<style>
  .photo {
    margin: 0;
    width: 100%;
    /* The cap lives here, on the element, driven by an inline custom property.
       Nothing about a slot's size depends on the layout that placed it. */
    max-width: var(--photo-max, 100%);
  }
  .photo--center {
    margin-inline: auto;
  }
  .photo--start {
    margin-inline-end: auto;
  }
  .photo--sticky {
    position: sticky;
    top: calc(var(--header-h, 65px) + var(--space-5));
  }
  @media (max-width: 899px) {
    .photo--sticky {
      position: static;
    }
  }

  .photo__img {
    width: 100%;
    aspect-ratio: var(--photo-ratio);
    border-radius: var(--radius);
    display: block;
  }
  .photo__img {
    object-fit: cover;
    height: auto;
  }

  /* Phones get the mobile ratio, and a tighter caption — at full width the
     desktop gap reads as the caption drifting away from its image. */
  @media (max-width: 899px) {
    .photo__img {
      aspect-ratio: var(--photo-ratio-mobile, var(--photo-ratio));
    }
    .photo__caption {
      margin-block-start: var(--space-2);
    }
  }

  .photo__caption {
    /* Wraps inside the slot. Without this a long caption sets the figure's
       width and drags the image out with it. */
    max-width: 100%;
    overflow-wrap: break-word;
    margin-block-start: var(--space-3);
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--ink) 66%, var(--surface));
  }
  .photo--dark .photo__caption {
    color: var(--rule);
  }
</style>
