---
/**
 * Site header — logo, primary nav, phone CTA.
 *
 * Nav comes from src/data/nav.json (§9) so structure is declared once and
 * cannot drift as pages ship. Only entries flagged `built` render, so the
 * live nav never contains a dead link; scripts/check-nav.mjs fails the build
 * if a built:true URL has no page in dist/.
 *
 * A dropdown group disappears entirely when none of its children are built —
 * an empty "Services" menu is worse than no menu.
 *
 * Phone href is the exact string tel:2084094505 — no dashes, no parens.
 */
import { PHONE_DISPLAY, PHONE_HREF } from "../data/site";
import navData from "../data/nav.json";

type Link = { label: string; href: string; built: boolean };
type Group = { label: string; kind: "group"; children: Link[] };
type Item = Link | Group;

const isGroup = (item: Item): item is Group =>
  "kind" in item && item.kind === "group";

// While previewUnbuilt is on, unbuilt entries still render — as plain labels,
// never as links — so the nav structure is visible during the build. With it
// off, they are dropped entirely and a group with no built children goes with
// them. Either way the nav contains no link to a page that does not exist.
const preview = navData.previewUnbuilt === true;
const shows = (entry: Link) => entry.built || preview;

const nav = (navData.primary as Item[])
  .map((item) =>
    isGroup(item)
      ? { ...item, children: item.children.filter(shows) }
      : item,
  )
  .filter((item) => (isGroup(item) ? item.children.length > 0 : shows(item)));

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label="Enviro-Tech Idaho — home">
      <img
        src="/enviro-tech-idaho-logo.png"
        alt="Enviro-Tech Idaho"
        class="brand__logo"
        width="990"
        height="192"
      />
    </a>

    {
      nav.length > 0 && (
        <button
          type="button"
          class="nav-toggle"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="Open menu"
          data-nav-toggle
        >
          <span class="nav-toggle__bars" aria-hidden="true">
            <span /><span /><span />
          </span>
        </button>
      )
    }

    {
      nav.length > 0 && (
        <nav class="nav" id="site-nav" aria-label="Primary" data-nav>
          <ul class="nav__list">
            {nav.map((item) =>
              isGroup(item) ? (
                <li class="nav__item nav__item--group" data-nav-group>
                  <button
                    type="button"
                    class="nav__trigger"
                    aria-expanded="false"
                    aria-controls={`submenu-${item.label.toLowerCase()}`}
                    data-nav-trigger
                  >
                    {item.label}
                    <svg
                      class="nav__chevron"
                      viewBox="0 0 12 12"
                      width="12"
                      height="12"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="m2.5 4.5 3.5 3.5 3.5-3.5"
                      />
                    </svg>
                  </button>
                  <ul class="nav__sub" id={`submenu-${item.label.toLowerCase()}`}>
                    {item.children.map((child) => (
                      <li>
                        {child.built ? (
                          <a
                            href={child.href}
                            aria-current={currentPath === child.href ? "page" : undefined}
                          >
                            {child.label}
                          </a>
                        ) : (
                          <span class="nav__soon" aria-disabled="true">
                            {child.label}
                            <span class="nav__tag mono">soon</span>
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li class="nav__item">
                  {item.built ? (
                    <a
                      href={item.href}
                      aria-current={currentPath === item.href ? "page" : undefined}
                    >
                      {item.label}
                    </a>
                  ) : (
                    <span class="nav__soon" aria-disabled="true">
                      {item.label}
                      <span class="nav__tag mono">soon</span>
                    </span>
                  )}
                </li>
              ),
            )}
          </ul>
        </nav>
      )
    }

    <a href={PHONE_HREF} class="header-call">
      <span class="header-call__prefix">Call 24/7&nbsp;&middot;&nbsp;</span>{PHONE_DISPLAY}
    </a>
  </div>
</header>

<style>
  /* Dark band at the top of the page — light type + logo on --ink. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ink);
    border-block-end: 1px solid color-mix(in srgb, var(--spark) 40%, transparent);
    --header-h: 65px;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 64px;
    padding-block: var(--space-3);
  }

  /* Logo — the supplied asset (white type + green mark) on the dark header.
     990×192 native; height-constrained, width auto to preserve ratio. */
  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    margin-inline-end: auto;
  }
  .brand__logo {
    height: 34px;
    width: auto;
  }

  /* --- Shared link treatment ------------------------------------------- */

  .nav a,
  .nav__trigger,
  .nav__soon {
    display: block;
    color: var(--surface);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--step-0);
    font-family: inherit;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .nav a:hover,
  .nav__trigger:hover {
    color: var(--spark);
  }
  /* Unbuilt entries — visible structure, deliberately not links. Muted and
     non-interactive so they read as pending rather than broken. Disappears
     entirely once previewUnbuilt is off. */
  .nav__soon {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: color-mix(in srgb, var(--surface) 45%, transparent);
    font-weight: 600;
    cursor: default;
  }
  .nav__tag {
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 1px 5px;
    border-radius: 2px;
    border: 1px solid color-mix(in srgb, var(--surface) 22%, transparent);
    color: color-mix(in srgb, var(--surface) 55%, transparent);
  }

  /* Current page marked with a --spark hairline — thin accent use only. */
  .nav a[aria-current="page"] {
    color: var(--spark);
    box-shadow: inset 0 -2px 0 var(--spark);
  }

  .nav__trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .nav__chevron {
    transition: transform 0.15s ease;
  }
  [data-nav-trigger][aria-expanded="true"] .nav__chevron {
    transform: rotate(180deg);
  }

  /* --- Hamburger -------------------------------------------------------- */

  .nav-toggle {
    display: none; /* shown in the mobile block below */
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px; /* tap target floor (§13) */
    padding: 0;
    background: none;
    border: 1px solid color-mix(in srgb, var(--rule) 30%, transparent);
    border-radius: var(--radius);
    color: var(--surface);
    cursor: pointer;
  }
  .nav-toggle__bars {
    position: relative;
    display: block;
    width: 20px;
    height: 14px;
  }
  .nav-toggle__bars span {
    position: absolute;
    inset-inline: 0;
    height: 2px;
    background: currentColor;
    transition:
      transform 0.18s ease,
      opacity 0.18s ease;
  }
  .nav-toggle__bars span:nth-child(1) {
    top: 0;
  }
  .nav-toggle__bars span:nth-child(2) {
    top: 6px;
  }
  .nav-toggle__bars span:nth-child(3) {
    top: 12px;
  }
  /* Bars morph into an X when open. */
  [aria-expanded="true"] .nav-toggle__bars span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  [aria-expanded="true"] .nav-toggle__bars span:nth-child(2) {
    opacity: 0;
  }
  [aria-expanded="true"] .nav-toggle__bars span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* --- Desktop ---------------------------------------------------------- */

  @media (min-width: 900px) {
    .nav__list {
      display: flex;
      align-items: center;
      gap: var(--space-5);
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .nav__item {
      position: relative;
    }

    /* Dropdown. Opens from the trigger's own state, and also on hover and
       focus-within so it still works if the script fails to load. */
    .nav__sub {
      position: absolute;
      inset-block-start: calc(100% + var(--space-3));
      inset-inline-start: 0;
      z-index: 10;
      min-width: 16rem;
      margin: 0;
      padding: var(--space-2);
      list-style: none;
      background: var(--ink);
      border: 1px solid color-mix(in srgb, var(--rule) 25%, transparent);
      border-radius: var(--radius);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-4px);
      transition:
        opacity 0.15s ease,
        transform 0.15s ease,
        visibility 0.15s;
    }
    .nav__item--group:hover .nav__sub,
    .nav__item--group:focus-within .nav__sub,
    [data-nav-trigger][aria-expanded="true"] + .nav__sub {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    /* Bridges the gap between trigger and panel so the pointer can cross. */
    .nav__item--group::after {
      content: "";
      position: absolute;
      inset-inline: 0;
      inset-block-start: 100%;
      height: var(--space-3);
    }
    .nav__sub a,
    .nav__sub .nav__soon {
      padding: var(--space-3);
      border-radius: var(--radius);
      font-weight: 400;
      width: 100%;
      justify-content: space-between;
    }
    .nav__sub a:hover {
      background: color-mix(in srgb, var(--surface) 8%, transparent);
    }
  }

  /* --- Mobile ----------------------------------------------------------- */

  @media (max-width: 899px) {
    .nav-toggle {
      display: inline-flex;
      order: 2;
    }
    .header-call {
      order: 1;
    }

    /* Full-height panel below the header band. */
    .nav {
      position: fixed;
      inset-block-start: var(--header-h);
      inset-block-end: 0;
      inset-inline: 0;
      z-index: 40;
      overflow-y: auto;
      padding: var(--space-5) var(--gutter) var(--space-9);
      background: var(--ink);
      border-block-start: 1px solid color-mix(in srgb, var(--rule) 20%, transparent);
      transform: translateX(-100%);
      visibility: hidden;
      transition:
        transform 0.2s ease,
        visibility 0.2s;
    }
    .nav[data-open="true"] {
      transform: translateX(0);
      visibility: visible;
    }

    .nav__list {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .nav__item {
      border-block-end: 1px solid color-mix(in srgb, var(--rule) 15%, transparent);
    }
    .nav a,
    .nav__trigger,
    .nav__soon {
      width: 100%;
      min-height: 52px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: var(--step-1);
      text-align: start;
    }
    .nav__trigger {
      justify-content: space-between;
    }

    /* Accordion rather than a dropdown at this width. */
    .nav__sub {
      list-style: none;
      margin: 0;
      padding: 0 0 var(--space-3) var(--space-4);
      display: none;
    }
    [data-nav-trigger][aria-expanded="true"] + .nav__sub {
      display: block;
    }
    .nav__sub a,
    .nav__sub .nav__soon {
      min-height: 44px;
      font-size: var(--step-0);
      font-weight: 400;
      border-inline-start: 1px solid color-mix(in srgb, var(--rule) 20%, transparent);
      padding-inline-start: var(--space-4);
    }
  }

  /* --- Phone CTA -------------------------------------------------------- */

  /* Filled seal button (NOT amber; amber is emergency-only).
     One continuous string: "Call 24/7 · (208) 409-4505". The prefix is a
     span only so it can drop on narrow screens — it carries no typography of
     its own, so the label and the number are a single uniform run of text. */
  .header-call {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    min-height: 44px; /* governs the height; tap target floor (§13) */
    background: var(--seal);
    color: var(--paper);
    border-radius: var(--radius);
    text-decoration: none;
    white-space: nowrap;
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1;
  }
  .header-call:hover {
    background: color-mix(in srgb, var(--seal) 88%, black);
  }

  @media (max-width: 560px) {
    /* "Call 24/7 · " plus the number overruns the logo below ~560px. The
       number is the part that matters; the sticky call bar carries the 24/7
       framing on mobile. */
    .header-call__prefix {
      display: none;
    }
    .brand__logo {
      height: 28px;
    }
  }
</style>

<script>
  /**
   * Nav behaviour — the mobile panel and the Services dropdown.
   *
   * One of only two scripts on the site (§14). CSS already opens the desktop
   * dropdown on hover and focus-within, so a failure here degrades to a menu
   * that still works with a mouse and with Tab; this adds click-to-open,
   * Escape, click-outside, and the aria state.
   */
  const DESKTOP = window.matchMedia("(min-width: 900px)");

  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-nav]");
  const triggers = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-nav-trigger]"),
  );

  const closeDropdowns = (except?: Element) => {
    for (const trigger of triggers) {
      if (trigger !== except) trigger.setAttribute("aria-expanded", "false");
    }
  };

  const setPanel = (open: boolean) => {
    if (!toggle || !panel) return;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    panel.dataset.open = String(open);
    // Lock the page behind the panel so it does not scroll underneath.
    document.body.classList.toggle("nav-open", open);
    if (!open) closeDropdowns();
  };

  toggle?.addEventListener("click", () => {
    setPanel(toggle.getAttribute("aria-expanded") !== "true");
  });

  for (const trigger of triggers) {
    trigger.addEventListener("click", () => {
      const open = trigger.getAttribute("aria-expanded") === "true";
      closeDropdowns(trigger);
      trigger.setAttribute("aria-expanded", String(!open));
    });
  }

  // Selecting a destination closes the panel. Dropdown triggers are buttons,
  // so this only fires for real links.
  panel?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a") && !DESKTOP.matches) {
      setPanel(false);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;

    const openTrigger = triggers.find(
      (t) => t.getAttribute("aria-expanded") === "true",
    );
    if (openTrigger) {
      openTrigger.setAttribute("aria-expanded", "false");
      openTrigger.focus();
      return;
    }
    if (toggle?.getAttribute("aria-expanded") === "true") {
      setPanel(false);
      toggle.focus();
    }
  });

  // Clicking away closes an open dropdown on desktop.
  document.addEventListener("click", (event) => {
    if (!(event.target as HTMLElement).closest("[data-nav-group]")) {
      closeDropdowns();
    }
  });

  // Crossing the breakpoint resets state so the panel cannot be left open and
  // hidden, or the body left scroll-locked, after a resize or rotation.
  DESKTOP.addEventListener("change", () => {
    setPanel(false);
    closeDropdowns();
  });
</script>
