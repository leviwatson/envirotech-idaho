{
  "name": "envirotech-idaho",
  "compatibility_date": "2026-08-25",

  // The site is static. This Worker exists only for POST /api/lead —
  // `run_worker_first` scopes it to /api/*, so every other request is served
  // straight from ./dist by Cloudflare's asset layer, no Worker invocation.
  "main": "./src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "observability": { "enabled": true },

  // Rate limit per hashed client IP. Deliberately loose: a household behind
  // one address, or a realtor sending several properties, must not be blocked.
  // This is here to stop floods, not to ration real people.
  "ratelimits": [
    {
      "name": "LEAD_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]

  // Secrets, never committed:
  //   npx wrangler secret put LEAD_WEBHOOK_URL
  //   npx wrangler secret put LEAD_WEBHOOK_TOKEN   (optional)
}
