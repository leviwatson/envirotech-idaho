{
  "name": "envirotech-idaho",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run check:placeholders && npm run check:structure && npm run check:schema && npm run check:nav && npm run check:images",
    "check:placeholders": "! grep -rlI '{{' dist/ || (echo 'Unfilled placeholder in build output' && exit 1)",
    "preview": "astro preview",
    "astro": "astro",
    "check:nav": "node scripts/check-nav.mjs",
    "check:images": "node scripts/check-images.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "check:schema": "node scripts/check-schema.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "astro": "^7.2.7"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "wrangler": "^4.126.0",
    "yaml": "^2.9.0"
  }
}
